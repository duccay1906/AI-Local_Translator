{
  "name": "ai-local-translator",
  "version": "1.0.9",
  "description": "AI-powered Local Desktop Translation App with LM Studio",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node -e \"require('fs').copyFileSync('build/icon.png', 'dist-electron/icon.png'); require('fs').copyFileSync('build/icon.ico', 'dist-electron/icon.ico'); require('fs').copyFileSync('electron/icon@4x.png', 'dist-electron/icon@4x.png');\"",
    "package": "tsc && vite build && node -e \"require('fs').copyFileSync('build/icon.png', 'dist-electron/icon.png'); require('fs').copyFileSync('build/icon.ico', 'dist-electron/icon.ico'); require('fs').copyFileSync('electron/icon@4x.png', 'dist-electron/icon@4x.png');\" && electron-builder",
    "updates:serve": "node scripts/serve-updates.js",
    "updates:publish": "node scripts/publish-update.js"
  },
  "build": {
    "appId": "com.xavis.ailocaltranslator",
    "productName": "AI Local Translator",
    "asar": false,
    "icon": "build/icon.ico",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": true,
      "perMachine": false,
      "include": "build/installer.nsh"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/**/*"
    ]
  },
  "dependencies": {
    "lucide-react": "^0.427.0",
    "marked": "^18.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.4",
    "vite": "^5.3.5",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
